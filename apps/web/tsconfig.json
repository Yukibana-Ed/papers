{
  /* The repository's strict settings, then what SvelteKit provides ($app/tsconfig): the module system, the target and
     the libraries for Vite. */
  "extends": ["../../tsconfig.strict.json", "$app/tsconfig"],
  "compilerOptions": {
    "moduleDetection": "force",
    "allowJs": false,
    "checkJs": false,
    "types": ["$app/types", "vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "tests/**/*.ts", "e2e/**/*.ts", "vite.config.ts", "playwright.config.ts"]
}
