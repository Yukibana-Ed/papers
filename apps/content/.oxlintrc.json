{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../oxlint.strict.json"],
  "rules": {
    /* SvelteKit's `redirect()` and `error()` never return; the rule cannot see that. */
    "typescript/consistent-return": "off",
    /* `export {}` is how a .d.ts becomes a module, per SvelteKit's own template. */
    "unicorn/require-module-specifiers": "off"
  },
  "ignorePatterns": ["build/**", ".svelte-kit/**", "static/**", "node_modules/**", "src/lib/lsp/vendor/**"]
}
