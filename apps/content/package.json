{
  "private": true,
  "name": "@yukibana/papers-content",
  "version": "0.0.0-dev",
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev --port 5185",
    "fetch:engine": "node scripts/engine.ts fetch",
    "fetch:typst": "node scripts/typst.ts fetch",
    "tlstore": "node scripts/tlstore.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "svelte-kit sync && oxlint --type-aware --deny-warnings"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "@yukibana/design": "catalog:",
    "@yukibana/pdftex-wasm": "catalog:",
    "fast-check": "catalog:",
    "pdfjs-dist": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "texlyre-busytex": "catalog:",
    "typescript": "catalog:ts6",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-web-compiler": "catalog:",
    "@myriaddreamin/typst.ts": "catalog:",
    "@yukibana/papers-frame-protocol": "catalog:",
    "@yukibana/papers-tex-engine": "catalog:",
    "@yukibana/papers-tex": "catalog:"
  }
}
