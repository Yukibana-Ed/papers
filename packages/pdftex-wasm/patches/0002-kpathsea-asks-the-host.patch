--- a/texk/kpathsea/readable.c
+++ b/texk/kpathsea/readable.c
@@ -121,6 +121,10 @@
     free (fnw);
   return ((st != 0xFFFFFFFF) && !(st & FILE_ATTRIBUTE_DIRECTORY));
 }
+#elif defined (INC_HOST)
+/* The host says what FN is; its size and times are not asked for.  */
+extern int inc_kind (const char *path); /* 0 nothing, 1 file, 2 directory */
+#define READABLE(kpse, fn, st) ((void) (st), inc_kind (fn) == 1)
 #else /* not __DJGPP__ and not WIN32 */
 #define READABLE(kpse, fn, st) \
  (access((fn), R_OK) == 0 && stat((fn), &(st)) == 0 && !S_ISDIR ((st).st_mode))
