+    /// Yukibana: `{ files, pages }`, the source of every glyph of the paged document that came from a file of
+    /// the project: `files` are paths and each of `pages` is a `Uint8Array` holding `spans::FIELDS` little-endian f64 numbers per glyph
+    /// (see `spans.rs`). Undefined when the document did not compile.
+    pub fn glyph_spans(&mut self) -> Result<JsValue, JsValue> {
+        let Some(doc) = self.do_compile_paged()? else {
+            return Ok(JsValue::UNDEFINED);
+        };
+        let spans = spans::glyph_spans(&self.graph.snap.world, &doc);
+        let files = Array::new();
+        for f in &spans.files {
+            files.push(&JsValue::from_str(f));
+        }
+        let pages = Array::new();
+        for p in &spans.pages {
+            // As bytes (little-endian f64), read on the other side through a Float64Array on the same buffer: the
+            // module then imports nothing the published build does not, and its JS bindings fit this build too.
+            let bytes: Vec<u8> = p.iter().flat_map(|v| v.to_le_bytes()).collect();
+            pages.push(&Uint8Array::from(bytes.as_slice()));
+        }
+        let result = js_sys::Object::new();
+        js_sys::Reflect::set(&result, &"files".into(), &files)?;
+        js_sys::Reflect::set(&result, &"pages".into(), &pages)?;
+        Ok(result.into())
+    }
